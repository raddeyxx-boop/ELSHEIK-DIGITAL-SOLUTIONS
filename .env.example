# Public Supabase configuration. The site renders without these during local UI work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New Supabase projects may use a publishable key instead of the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# New Supabase projects may use a secret key instead of the legacy service-role key.
SUPABASE_SECRET_KEY=

# Optional deployment URL used for canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
