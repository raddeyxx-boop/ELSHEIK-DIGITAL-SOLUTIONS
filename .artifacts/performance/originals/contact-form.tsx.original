"use client";
import { useState } from "react";import { zodResolver } from "@hookform/resolvers/zod";import { useForm } from "react-hook-form";import type { Dictionary } from "@/content/dictionaries/types";import { inquirySchema,type InquiryInput } from "@/lib/validation/inquiry";import styles from "./contact-form.module.css";
// Receives only the contact copy: the whole dictionary would be serialized into the page payload.
export function ContactForm({dictionary:d}:{dictionary:Pick<Dictionary,"contact">}){const [result,setResult]=useState<{ok:boolean;persisted?:boolean;message?:string}|null>(null);const {register,handleSubmit,formState:{errors,isSubmitting},reset}=useForm<InquiryInput>({resolver:zodResolver(inquirySchema),defaultValues:{service:"unsure",website:""}});const submit=handleSubmit(async(data)=>{setResult(null);try{const response=await fetch("/api/inquiries",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(data)});const body=await response.json() as {ok:boolean;persisted?:boolean;error?:string};setResult({ok:body.ok,persisted:body.persisted,message:body.error});if(body.ok)reset();}catch{setResult({ok:false,message:"Network request failed."});}});const field=(name:keyof InquiryInput,label:string,required=false,type="text")=><label><span>{label}{!required&&<small>{d.contact.fields.optional}</small>}</span><input type={type} {...register(name)} aria-invalid={Boolean(errors[name])}/>{errors[name]&&<em>{errors[name]?.message}</em>}</label>;return <form className={styles.form} onSubmit={submit} noValidate><input className={styles.honeypot} tabIndex={-1} autoComplete="off" {...register("website")}/><div className={styles.grid}>{field("name",d.contact.fields.name,true)}{field("company",d.contact.fields.company)}{field("email",d.contact.fields.email,true,"email")}{field("phone",d.contact.fields.phone)}{field("country",d.contact.fields.country)}<label><span>{d.contact.fields.service}</span><select {...register("service")}>{["website","web-application","mobile-application","automation","ai","custom-software","unsure"].map(v=><option key={v} value={v}>{v.replaceAll("-"," ")}</option>)}</select></label>{field("budget",d.contact.fields.budget)}{field("timeline",d.contact.fields.timeline)}</div><label><span>{d.contact.fields.description}</span><textarea rows={7} {...register("description")} aria-invalid={Boolean(errors.description)}/>{errors.description&&<em>{errors.description.message}</em>}</label><div className={styles.submit}><button className="button button-primary" disabled={isSubmitting}>{isSubmitting?d.contact.submitting:d.contact.submit}</button>{result?.ok&&<p role="status">{d.contact.success}{result.persisted===false&&<small>{d.contact.devNotice}</small>}</p>}{result&&!result.ok&&<p role="alert" className={styles.error}>{result.message}</p>}</div></form>}

